# CloudMosaic Staging Environment Configuration Template (.env.staging.example)
# Copy to .env on the Linux staging server and supply genuine secrets

# PostgreSQL Database Configuration
DB_NAME=cloudmosaic_staging_db
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_STAGING_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_STAGING_PASSWORD
DB_HOST=db
DB_PORT=5432

# Django Backend Configuration
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_50_CHAR_KEY_NO_INSECURE_PREFIX
ALLOWED_HOSTS=staging.cloudmosaic.ai,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://staging.cloudmosaic.ai,http://localhost
CSRF_TRUSTED_ORIGINS=https://staging.cloudmosaic.ai

# Frontend Configuration
REACT_APP_API_URL=https://staging.cloudmosaic.ai/api/v1

# Optional Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
