# ==============================================================================
# CloudMosaic Production Git Ignore Configuration
# ==============================================================================

# Environment & Secrets
.env
.env.local
.env.*.local
*.env
backend/.env
cloudmosaic-react-main/.env

# Preserved environment templates
!.env.example
!.env.staging.example
!backend/.env.example
!cloudmosaic-react-main/.env.example
!cloudmosaic-react-main/.env.production

# Python Virtual Environments & Packages
.venv/
.audit-venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/.audit-venv/

# Node.js & React Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
cloudmosaic-react-main/node_modules/
cloudmosaic-react-main/build/
build/
dist/

# Database Files & Test Databases
*.sqlite3
test_db.sqlite3
*.dump
*.sql
scripts/backups/*.dump
scripts/backups/*.sql
scripts/backups/*.sha256
backups/

# User Uploaded Media (Protect applicant resumes)
backend/media/resumes/*
!backend/media/resumes/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
